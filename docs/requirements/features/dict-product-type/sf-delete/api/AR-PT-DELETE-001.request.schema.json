{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Запрос удаления видов изделий",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pks"
  ],
  "properties": {
    "pks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Идентификаторы удаляемых записей: от 1 до 100, без повторов"
    }
  }
}
